# =============================================================================
# .gitattributes — Controls GitHub "Download ZIP" exports
# Files marked with `export-ignore` are EXCLUDED from the zip download
# but remain tracked in git normally.
#
# NOTE: Only non-functional files are excluded here so that anyone
# downloading the zip can still set up and run the project.
# =============================================================================

# --- IDE & editor config (not needed for setup) ---
.vscode/                      export-ignore

# --- Test artifacts (not needed for setup) ---
frontend/test-results/        export-ignore

# --- AI export script (dev utility, not needed for setup) ---
export-for-ai.ps1             export-ignore
